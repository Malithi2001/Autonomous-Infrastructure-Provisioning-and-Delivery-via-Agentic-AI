APP_NAME="Smart DevOps Assistant"
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Local SQLite is easiest for development. Docker Compose overrides this to Postgres.
DATABASE_URL=sqlite+aiosqlite:///./devops_assistant.db
DATABASE_SSL_VERIFY=true
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=devops_pass
POSTGRES_DB=devops_assistant
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=devops_access_token

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434

# Local development GitHub PAT fallback.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_FULL_NAME=

# GitHub App onboarding for real repository installations.
GITHUB_APP_ID=
# Paste the GitHub App private key here for local testing only, using escaped newlines if needed.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional ML artifact overrides. Leave blank to use backend/app/ml/*.joblib.
FAILURE_MODEL_PATH=
FIX_MAPPING_PATH=

ENABLE_HITL=true
HITL_APPROVAL_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# Seed/admin defaults for local demo databases only.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
