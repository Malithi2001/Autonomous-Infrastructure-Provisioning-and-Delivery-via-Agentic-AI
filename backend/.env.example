# ============================================================
# Application Settings
# ============================================================
APP_NAME="Smart DevOps Assistant"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development   # development | staging | production

# ============================================================
# API Server
# ============================================================
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://devops_user:devops_pass@localhost:5432/devops_assistant
# For async: postgresql+asyncpg://...

# ============================================================
# Redis / Celery
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# Authentication
# ============================================================
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# LLM Providers (set at least one)
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
DEFAULT_LLM_PROVIDER=openai   # openai | anthropic
DEFAULT_MODEL=gpt-4o

# ============================================================
# DevOps Tool Integrations
# ============================================================
# GitHub
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# ============================================================
# Agent Configuration
# ============================================================
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
HITL_APPROVAL_TIMEOUT_SECONDS=300   # 5 minutes for human approval
ENABLE_HITL=True

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | text
AUDIT_LOG_RETENTION_DAYS=90
